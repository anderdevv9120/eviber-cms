{
  "name": "cms-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "oxlint --fix src",
    "prettier": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "prettier:fix": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@ant-design/icons": "6.3.4",
    "@lexical/code": "0.22.0",
    "@lexical/file": "0.22.0",
    "@lexical/hashtag": "0.22.0",
    "@lexical/html": "0.22.0",
    "@lexical/link": "0.22.0",
    "@lexical/list": "0.22.0",
    "@lexical/overflow": "0.22.0",
    "@lexical/react": "0.22.0",
    "@lexical/rich-text": "0.22.0",
    "@lexical/selection": "0.22.0",
    "@lexical/table": "0.22.0",
    "@lexical/utils": "0.22.0",
    "@lexical/yjs": "0.22.0",
    "antd": "6.6.5",
    "axios": "1.20.0",
    "clsx": "2.1.1",
    "dayjs": "^1.11.23",
    "immer": "11.1.18",
    "js-cookie": "3.0.8",
    "lexical": "0.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/js-cookie": "3.0.6",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "lint-staged": "17.6.0",
    "oxlint": "1.87.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "oxlint --max-warnings 0 --no-error-on-unmatched-pattern"
    ],
    "*.css": [
      "prettier --write"
    ]
  }
}
